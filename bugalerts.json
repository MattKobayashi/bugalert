p/input/status/system/ipIntfStatus`)\n    let ret = length(ipIntfs | where( dictHasKey(vlans, _key))) > 0\n\n    # Check ip6 if no ip interface found.\n    if !ret {\n        let ip6Intfs = merge(`<d>:/Sysdb/ip6/input/status/system/intf`)\n        let ret = length(ip6Intfs | where(dictHasKey(vlans, _key))) > 0\n    }\n}\n\nret', 'revision': 3, 'tag': 'vxlanRouting', 'description': 'VXLAN routing enabled - SVI on a VLAN associated to a VNI', 'pathFilters': ['/Sysdb/interface/status/eth/vxlan/vtiStatus', '/Sysdb/interface/status/eth/vxlan/vtiStatus/*/vlanToVniMap', '/Sysdb/ip/input/status/system/ipIntfStatus', '/Sysdb/ip6/input/status/system/intf']}, {'id': 1457, 'query': 'let ret = false\n\nlet vtiStatus = merge(`<d>:/Sysdb/interface/status/eth/vxlan/vtiStatus`{"Vxlan1"})\nif dictHasKey(vtiStatus, "Vxlan1") {\n    let vlanIDs = merge(`<d>:/Sysdb/interface/status/eth/vxlan/vtiStatus/Vxlan1/vlanToVniMap`)\n    let vlans = newDict()\n    for vlanID in dictKeys(vlanIDs) {\n        # VLAN IDs are complex keys with a "value" field; SVI names use the "Vlan" prefix.\n        vlans["Vlan" + str(vlanID["value"])] = true\n    }\n\n    # Check if a VLAN mapped to a VNI has an IPv4 or IPv6 interface.\n    let ipIntfs = merge(`<d>:/Sysdb/ip/input/status/system/ipIntfStatus`)\n    let ret = length(ipIntfs | where(dictHasKey(vlans, _key))) > 0\n    if !ret {\n        let ip6Intfs = merge(`<d>:/Sysdb/ip6/input/status/system/intf`)\n        let ret = length(ip6Intfs | where(dictHasKey(vlans, _key))) > 0\n    }\n}\n\nret', 'revision': 5, 'tag': 'vxlanRouting', 'description': 'VXLAN routing enabled - SVI on a VLAN associated to a VNI', 'pathFilters': ['/Sysdb/interface/status/eth/vxlan/vtiStatus', '/Sysdb/interface/status/eth/vxlan/vtiStatus/*/vlanToVniMap', '/Sysdb/ip/input/status/system/ipIntfStatus', '/Sysdb/ip6/input/status/system/intf']}, {'id': 1064, 'query': 'length(merge(`<d>:/Sysdb/interface/status/eth/vxlan/vtiStatus/Vxlan1/vtepToSecProfile`)) > 0', 'revision': 3, 'tag': 'Vxla