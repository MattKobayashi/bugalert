ed': ['4.29.7.3', '4.30.10', '4.31.8', '4.32.0.2', '4.32.1FX-400G-MACSEC.1', '4.32.6', '4.33.1'], 'bites': 5, 'lastBiteTime': 1775721380, 'exportedTime': 1775520000, 'releaseNote': 'Faulty cards can cause the active supervisor to reboot or result in transient failures of other linecards or fabric cards.', 'conjunction': [[{'tag': 'CCS-750'}], [{'tag': 'DCS-7800'}], [{'tag': '7300-SUP2-D'}]]}, {'bugId': 986518, 'severity': 'sev2', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'Multiple "dhcp server ipv4" or "dhcp server ipv6" configuration commands might be shown under an interface config if interface VRF change is performed via CVP.', 'alertNote': 'Multiple "dhcp server ipv4" or "dhcp server ipv6" configuration commands might\nbe shown under an interface config if interface VRF change is performed via\nCVP.\n\nTo avoid this issue, change the VRF and add the server configuration in\nseparate CVP transactions.\n\nTo work around when the switch is already in this state:\n1) via CVP/capiCli, disable CLI caching by issuing `agent ConfigAgent\nenvironment DISABLE_CLI_CACHE=1` in configure mode, restart ConfigAgent and\nthen reconfigure the interface to the correct vrf.\n\n2) via EOS CLI, reconfigure interface to the old VRF(s) and then perform "no\ndhcp server ipv4".\n', 'product': 'eos', 'versionIntroduced': ['4.28.2'], 'versionFixed': ['4.30.9', '4.31.6', '4.32.4', '4.33.1'], 'bites': 4, 'lastBiteTime': 1746816639, 'exportedTime': 1746576000, 'releaseNote': 'Multiple "dhcp server ipv4" or "dhcp server ipv6" configuration commands might\nbe shown under an interface config if interface VRF change is performed via\nCVP.\n\nTo avoid this issue, change the VRF and add the server configuration in\nseparate CVP transactions.\n\nTo work around when the switch is already in this state:\n1) via CVP/capiCli, disable CLI caching by issuing `agent ConfigAgent\nenvironment DISABLE_CLI_CACHE=1` in configure mode, restart ConfigAgent and\nthen reconfigure the interface to the correct vrf.\n\n2) via EOS CLI, reconfigure interface to the old VRF(s) and then perform "no\ndhcp server ipv4".\n'}, {'bugId': 987041, 'severity': 'sev3', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'A pci_read_config message with offset 0x100 is emitted in the PciBus agent logs every 30 seconds. This is harmless. There is no work- around.', 'alertNote': 'A pci_read_config message with offset 0x100 is emitted in the PciBus agent logs\nevery 30 seconds. This is harmless. There is no work-around.\n', 'product': 'eos', 'versionIntroduced': ['1.0.0'], 'versionFixed': ['4.34.5', '4.35.3', '4.36.0'], 'bites': 1, 'lastBiteTime': 1721232291, 'exportedTime': 1774483200, 'releaseNote': 'A pci_read_config message with offset 0x100 is emitted in the PciBus agent logs\nevery 30 seconds. This is harmless. There is no work-around.\n', 'conjunction': [[{'tag': 'TridentFamily'}], [{'tag': 'FM6000'}], [{'tag': 'CCS-720XP'}]]}, {'bugId': 989010, 'severity': 'sev1', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'A switch reboot may cause the system to become unresponsive and hang. A workaround is to physically unplug and replug the power cable to recover.', 'alertNote': 'A switch reboot may cause the system to become unresponsive and hang.\n\nA workaround is to physically unplug and replug the power cable to recover.', 'product': 'eos', 'versionIntroduced': ['1.0.0'], 'versionFixed': ['4.33.8', '4.34.8', '4.35.2'], 'bites': 1, 'lastBiteTime': 1779413236, 'exportedTime': 1778803200, 'releaseNote': 'A switch reboot may cause the system to become unresponsive and hang.\n\nA workaround is to physically unplug and replug the power cable to recover.', 'conjunction': [[{'tag': 'PrairieIslandCpu'}]]}, {'bugId': 989455, 'severity': 'sev1', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'If egress replication mode is being used, in the presence of micro-burst or high rate of BUM or multicast traffic, one or more of the chips on the switch might enter a state where all subsequent replicated traffic is completely dropped.', 'alertNote': 'On a switch where egress replication mode is being used, in the presence of micro-burst or high rate of BUM or L2/L3 multicast traffic, one or more of the chips on the switch might enter a state where all subsequent replicated traffic is completely dropped. In this state, MAC learning could also be impacted. Note that even if the system is operating in ingress-only global replication mode, egress replication could be used for features such as EVPN OISM over VXLAN or VPLS.\n\nOnce a chip gets into this state, it can be recovered by either performing a soft reset using "reset platform fap full" CLI command or performing a reload of the switch.\n\nWorkaround: In the absence of above-mentioned features that force the use of egress replication, the switch can be configured to operate in global ingress-only replication mode to avoid this issue.\n', 'product': 'eos', 'versionIntroduced': ['4.27.0'], 'versionFixed': ['4.31.8', '4.32.6', '4.33.4', '4.34.2'], 'bites': 7, 'lastBiteTime': 1786707016, 'exportedTime': 1774915200, 'releaseNote': 'On a switch where egress replication mode is being used, in the presence of micro-burst or high rate of BUM or L2/L3 multicast traffic, one or more of the chips on the switch might enter a state where all subsequent replicated traffic is completely dropped. In this state, MAC learning could also be impacted. Note that even if the system is operating in ingress-only global replication mode, egress replication could be used for features such as EVPN OISM over VXLAN or VPLS.\n\nOnce a chip gets into this state, it can be recovered by either performing a soft reset using "reset platform fap full" CLI command or performing a reload of the switch.\n\nWorkaround: In the absence of above-mentioned features that force the use of egress replication, the switch can be configured to operate in global ingress-only replication mode to avoid this issue.\n', 'conjunction': [[{'tag': 'SandGen4'}]]}, {'bugId': 989881, 'severity': 'sev1', 'securityAdvisoryURL': 'https://www.arista.com/en/support/advisories-notices/security-advisory/21086-security-advisory-0109', 'cve': 'CVE-2024-8000', 'alertSummary': 'https://www.arista.com/en/support/advisories-notices/security-advisory/21086-security-advisory-0109', 'alertNote': 'Only the first line of multi line dynamic ACLs were being restored post-ASU for dot1x supplicants with ACLs attached. Now multi line dynamic ACLs will be restored in full during ASU for Dot1x supplicants. More Details: https://www.arista.com/en/support/advisories-notices/security-advisory/21086-security-advisory-0109', 'product': 'eos', 'versionIntroduced': ['4.30.2'], 'versionFixed': ['4.30.9', '4.31.6', '4.32.4', '4.33.0'], 'bites': 1, 'lastBiteTime': 1736932672, 'exportedTime': 1736467200, 'releaseNote': 'Only the first line of multi line dynamic ACLs were being restored post-ASU for dot1x supplicants with ACLs attached. Now multi line dynamic ACLs will be restored in full during ASU for Dot1x supplicants. More Details: https://www.arista.com/en/support/advisories-notices/security-advisory/21086-security-advisory-0109', 'conjunction': [[{'tag': 'dot1xConfigured'}, {'tag': 'Strata'}]]}, {'bugId': 989993, 'severity': 'sev2', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'Routes may not be advertised by BGP or redistributed correctly during route churn when update wait-install is enabled. Adding a new route will ensure the route is advertised or redistributed correctly.', 'alertNote': 'Routes may not be advertised by BGP or redistributed correctly during route churn when update wait-install is enabled.\n\nAdding a new route will ensure the route is advertised or redistributed correctly.', 'product': 'eos', 'versionIntroduced': ['4.31.1'], 'versionFixed': ['4.31.6', '4.32.0'], 'bites': 3, 'lastBiteTime': 1773538913, 'exportedTime': 1744675200, 'releaseNote': 'Routes may not be advertised by BGP or redistributed correctly during route churn when update wait-install is enabled.\n\nAdding a new route will ensure the route is advertised or redistributed correctly.', 'conjunction': [[{'tag': 'BGPUpdateWaitInstall'}]]}, {'bugId': 990767, 'severity': 'sev2', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'On MLAG devices running EVPN OISM,mlag shut/no shut may result in traffic loss.On devices running EVPN OISM in a non MLAG scenario could result in PIM neighborship being formed across the EVPN fabric,could prevent traffic from being routed & traffic loss', 'alertNote': 'On MLAG devices running EVPN OISM, `mlag shut` `no shut` may result in traffic loss.\nOn devices running EVPN OISM in a non MLAG scenario could result in PIM neighborship being formed across the EVPN fabric, this could prevent traffic from being routed and result in traffic loss.', 'product': 'eos', 'versionIntroduced': ['4.24.2'], 'versionFixed': ['4.34.2'], 'bites': 2, 'lastBiteTime': 1724382587, 'exportedTime': 1754352000, 'releaseNote': 'On MLAG devices running EVPN OISM, `mlag shut` `no shut` may result in traffic loss.\nOn devices running EVPN OISM in a non MLAG scenario could result in PIM neighborship being formed across the EVPN fabric, this could prevent traffic from being routed and result in traffic loss.', 'conjunction': [[{'tag': 'evpnEnabled'}, {'tag': 'mlagEnabled'}]]}, {'bugId': 990910, 'severity': 'sev1', 'securityAdvisoryURL': '', 'cve': '', 'alertSummary': 'When a forwarding ASIC gets reset, the device may unexpectedly reload.', 'alertNote': 'When a forwarding ASIC gets reset, the device may unexpectedly reload.', 'product': 'eos', 'versionIntroduced': ['1.0.0'], 'versionFixed': ['4.29.10', '4.30.9', '4.31.6', '4.32.3', '4.33.0'], 'bites': 1, 'lastBiteTime': 1765733933, 'exportedTime': 1728604800, 'releaseNote': 'When a forwarding ASIC gets reset, the device may unexpectedly reload.', 'conjunction': [[{'tag': 'Sand'}]]}, {'bugId': 991329, 'severity': 'sev1', 'securityAdvisoryURL': '', 'cve': '', 'alertSummar