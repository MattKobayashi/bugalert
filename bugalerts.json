here(length(merge(_value)) > 0)) > 0', 'revision': 1, 'tag': 'stpEnabled', 'pathFilters': ['/Sysdb/stp/status/stpiStatus/*/mstiStatus']}, {'id': 564, 'query': 'length(merge(`{_d}:/Sysdb/interface/config/subintf/intfConfig`)) > 0', 'revision': 1, 'tag': 'subintEnabled', 'description': 'This only checks that subintf config exists, and not other config (e.g. parent interface, vlan etc.)', 'pathFilters': ['/Sysdb/interface/config/subintf/intfConfig']}, {'id': 615, 'query': '# get vrfs with no ipv4 routing and vrfs with no ipv6 routing\nlet vrfNoRouting = `{_d}:/Sysdb/routing/vrf/routingInfo/status/*` | map(merge(_value)["routing"]) | where(!_value)\nlet vrfNoRouting6 = `{_d}:/Sysdb/routing6/vrf/routingInfo/status/*` | map(merge(_value)["routing"]) | where(!_value)\n\n# count number of vlan interfaces assigned to each vrf\nlet vrfVlanCount = `{_d}:/Sysdb/ip/status/vrfIpIntfStatus/*/ipIntfStatus` | map(length(merge(_value) | where(strHasPrefix(_key, "Vlan"))))\n\n# check for a vrf with vlans and no ipv4 or no ipv6 routing\nlength( vrfVlanCount | where(_value > 0 && (dictHasKey(vrfNoRouting, _key) || dictHasKey(vrfNoRouting6, _key)))) > 0', 'revision': 1, 'tag': 'svi-vrf-no-routing', 'description': 'An SVI is assigned to a VRF with ip or ipv6 routing disabled', 'pathFilters': ['/Sysdb/ip/status/vrfIpIntfStatus/*/ipIntfStatus', '/Sysdb/routing/vrf/routingInfo/status/*', '/Sysdb/routing6/vrf/routingInfo/status/*']}, {'id': 565, 'query': 'merge(`{_d}:/Sysdb/tapagg/cliconfig`)["mode"]["Name"] != "tapAggModeNone" && length(`{_d}:/Sysdb/tapagg/status/group/*`) > 0', 'revision': 1, 'tag': 'tapaggEnabled', 'description': 'Tap aggregation is enabled and at least one group exists', 'pathFilters': ['/Sysdb/tapagg/cliconfig', '/Sysdb/tapagg/status/group/*']}, {'id': 977, 'query': 'let ingressTrafficPolicies = merge(`{_d}:/Sysdb/trafficPolicies/intf/input/aegis/intf`)\nlength(ingressTrafficPolicies) > 0', 'revision': 1, 'tag': 'TrafficPolicyInput', 'description': 'traffic-policy input is applied on Ethernet ports and Port-Channels', 'pathFilters': ['/Sysdb/trafficPolicies/intf/input/aegis/intf']}, {'id': 562, 'query': 'length(`{_d}:/Sysdb/routing/fhrp/config/varpConfig/varpIntfConfig/*/virtualIpAddr` | where(length(merge(_value)) > 0)) > 0 || length(`{_d}:/Sysdb/routing/fhrp/config/varpConfig/varpIntfConfig/*/virtualIp6Addr` | where(length(merge(_value)) > 0)) > 0', 'revision': 1, 'tag': 'VARPEnabled', 'pathFilters': ['/Sysdb/routing/fhrp/config/varpConfig/varpIntfConfig/*/virtualIp6Addr', '/Sysdb/routing/fhrp/config/varpConfig/varpIntfConfig/*/virtualIpAddr']}, {'id': 878, 'query': 'let varpCfg = merge(`{_d}:/Sysdb/routing/fhrp/varp/config`)\nvarpCfg["virtualMacWithMask"]["mac"] != "00:00:00:00:00:00"', 'revision': 1, 'tag': 'VarpMacConf', 'description': 'ip virtual-router mac-address is configured', 'pathFilters': ['/Sysdb/routing/fhrp/varp/config']}, {'id': 941, 'query': 'let featureConf = merge(`{_d}:/Sysdb/flexCounter/featureConfigDir/cliAgent/feature`)\nlet featureSviEgress = featureConf | where(strContains(str(_key), "SviEgress") && strContains(str(_key), "16"))\nlength(featureSviEgress) > 0', 'revision': 1, 'tag': 'VlanIntCountersOut', 'description': 'Vlan Interface counters for egress are enabled', 'pathFilters': ['/Sysdb/flexCounter/featureConfigDir/cliAgent/feature']}, {'id': 526, 'query': 'length(merge(`{_d}:/Sysdb/vmtracer/status/session`)) > 0', 'revision': 1, 'tag': 'vmtracerEnabled', 'description': 'Check if a VM Tracer session exists', 'pathFilters': ['/Sysdb/vmtracer/status/session']}, {'id': 541, 'query': 'length(merge(`{_d}:/Sysdb/interface/status/eth/vxlan/vtiStatus/Vxlan1/vlanToVniMap`)) > 0', 'revision': 1, 'tag': 'vni-defined', 'description': 'A vlan vni mapping is available under vxlan', 'pathFilters': ['/Sysdb/interface/status/eth/vxlan/vtiStatus/Vxlan1/vlanToVniMap']}, {'id': 614, 'query': 'length(merge(`{_d}:/Sysdb/ip/vrf/config/vrf`) | where(_key != "default")) > 0', 'revision': 1, 'tag': 'vrfConfigured', 'description